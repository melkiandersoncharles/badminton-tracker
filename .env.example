# Public — bundled in the browser (VITE_ prefix)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional local-only dev fallback when Supabase is not configured (public)
VITE_GROUP_PIN=2580

# Secret — server-only, NO VITE_ prefix (used by /api/admin-verify on Vercel)
ADMIN_PIN=your-admin-secret
